# Copy to .env (git-ignored). Only EXPO_PUBLIC_* variables reach the app bundle; they are public.
# Server secrets (Eskiz, payment provider keys, service role) live in Supabase Edge Function env.

EXPO_PUBLIC_APP_ENV=dev                 # dev | staging | production
EXPO_PUBLIC_AUTH_PROVIDER=mock          # mock | supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPS_PROVIDER=yandex        # yandex | google
EXPO_PUBLIC_YANDEX_MAPS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_SENTRY_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
