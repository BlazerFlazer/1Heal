    "supabase": "^2.120.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:db": "tsc -p tsconfig.db.json --noEmit",
    "lint": "expo lint",
    "lint:fix": "expo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "check": "npm run typecheck && npm run typecheck:db && npm run lint && npm run test",
    "db:up": "node scripts/db/embedded.mjs up",
    "db:migrate": "node scripts/db/migrate.mjs --seed",
    "db:test": "jest --config jest.db.config.js",
    "db:types": "node scripts/db/gen-types.mjs",
    "db:sql": "node scripts/db/sql.mjs",
    "db:reset": "node scripts/db/embedded.mjs reset",
    "e2e": "maestro test e2e/",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
